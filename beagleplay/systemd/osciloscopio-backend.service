# Plantilla de la unidad de systemd del backend del osciloscopio.
# No se copia a mano: beagleplay/instalar_servicio.sh sustituye @REPO@, @HOME@ y @PYTHON@
# por los valores de la placa e instala el resultado en /etc/systemd/system/.

[Unit]
Description=Osciloscopio: backend FastAPI (SPI con el ESP32-C6)
Documentation=https://github.com/dahenaor-source/Osciloscopio-Linux-Embebido
After=network.target

[Service]
Type=simple
# Se ejecuta como root porque necesita abrir /dev/spidev0.0 (igual que con "sudo" a mano).
User=root
WorkingDirectory=@REPO@/beagleplay/backend
Environment=SPI_SPEED_HZ=2000000
Environment=PYTHONUNBUFFERED=1
# Los paquetes instalados con "pip3 install --break-system-packages" como usuario normal quedan en ~/.local
Environment=PYTHONUSERBASE=@HOME@/.local
# Solo escucha en 127.0.0.1: nginx (puerto 80) hace de proxy hacia este puerto.
ExecStart=@PYTHON@ -m uvicorn main:app --host 127.0.0.1 --port 8000
# Si el backend se cae, vuelve a levantarse solo.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
